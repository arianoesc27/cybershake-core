# AR: My settings for MareNostrum 5. I turn memcached off because MN5 does not have it.
# AR: I set CFLAGS and LIBS again, because SCEC's `:=` fixed the memcached include and -D_USE_MEMCACHED.
CFLAGS = -I${GETPARINCL} -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_IOBUF_MACROS -O3 -g
LIBS = -L${GETPARLIB} -lget -lgfortran -lm
