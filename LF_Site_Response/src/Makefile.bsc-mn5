# AR: MareNostrum 5 (BSC) site-specific overrides for LF_Site_Response
# AR: Points to our UCVM v25.7.1 and BBP 22.4.0 installs under software/

RUPGEN_DIR = ../../RuptureCodes/RupGen-api-5.5.2

UCVM_HOME  = /gpfs/projects/bsc115/bsc203748/software/ucvm/install
# AR: ucvm_interp.h and ucvm_model_elygtl.h live in the UCVM source tree, not install/include
UCVM_SRC   = /gpfs/projects/bsc115/bsc203748/software/ucvm
ETREE_HOME = ${UCVM_HOME}/lib/euclid3
PROJ4_HOME = ${UCVM_HOME}/lib/proj
VX_HOME    = ${UCVM_HOME}/model/cvmh
CVMS_HOME  = ${UCVM_HOME}/model/cvms
CVMSI_HOME = ${UCVM_HOME}/model/cvmsi
SFCVM_HOME = ${UCVM_HOME}/model/sfcvm

# AR: Embed RPATH so binaries find UCVM shared libs at runtime without LD_LIBRARY_PATH
UCVM_RPATH = -Wl,-rpath,${UCVM_HOME}/lib \
             -Wl,-rpath,${VX_HOME}/lib \
             -Wl,-rpath,${CVMS_HOME}/lib \
             -Wl,-rpath,${CVMSI_HOME}/lib \
             -Wl,-rpath,${SFCVM_HOME}/lib \
             -Wl,-rpath,${PROJ4_HOME}/lib \
             -Wl,-rpath,${ETREE_HOME}/lib

# AR: UCVM v25.7 renames libgeo -> libcvmh; adds libgrd and libgeomodelgrids (sfcvm dep)
# AR: I removed CENCAL, CCA, CVMS5 and CS173 because my UCVM install does not have them.
UCVMLIBS = -L${UCVM_HOME}/lib -lucvm -lgrd \
           -L${VX_HOME}/lib -lvxapi -lcvmh -lgctpc \
           -L${CVMS_HOME}/lib -lcvms \
           -L${CVMSI_HOME}/lib -lcvmsi \
           -L${SFCVM_HOME}/lib -lsfcvm -lgeomodelgrids \
           -L${PROJ4_HOME}/lib -lproj \
           -L${ETREE_HOME}/lib -letree \
           -lstdc++ -ldl ${UCVM_RPATH}

UCVMINC = -I${UCVM_HOME}/include -I${UCVM_SRC}/src/ucvm -I${GETPAR_DIR}/include

# AR: BBP 22.4.0 (LF site response does not need hb_high v6.1.1)
BBP_HOME = /gpfs/projects/bsc115/bsc203748/software/bbp/bbp-22.4.0/bbp
GP_DIR   = ${BBP_HOME}/src/gp
WCC_DIR  = ${GP_DIR}/WccFormat/Progs
# AR: functions_bbp.h includes "WccFormat/Progs/function.h", so it needs -I${GP_DIR} as base.
BBP_INC  = -I${GP_DIR}

# AR: BBP_OBJS override for recipe (lazy eval); parse-time prereq fixed in main makefile
BBP_OBJS = retrieve_vs.o iofunc.o misc.o \
           ${WCC_DIR}/wcc_siteamp14_sub.o \
           ${WCC_DIR}/integ_diff_sub.o \
           ${WCC_DIR}/wcc_getpeak_sub.o \
           ${WCC_DIR}/fft1d.o

# AR: There is no memcached on MN5, so I remove MEMCACHED_DIR from IFLAGS and -lmemcached from LDLIBS.
IFLAGS = -I${GETPAR_DIR}/include -I${RUPGEN_DIR}/include
LIBS   = -lm ${GETPAR_DIR}/lib/libget.a
LDLIBS = -L${RUPGEN_DIR}/lib -lrupgen ${LIBS} -lstdc++

UFLAGS = -O3 -Wimplicit-function-declaration -Wl,-upthread_mutex_destroy -g

# AR: UCVM v25.7 renamed UCVM_PARAM_QUERY_MODE -> UCVM_MODEL_PARAM_QUERY_MODE
# AR: get_vs30.c uses the old name; alias it at compile time without touching upstream source
CFLAGS = ${UFLAGS} ${LF_FLAGS} ${IFLAGS} -ldl -lgfortran \
         -DUCVM_PARAM_QUERY_MODE=UCVM_MODEL_PARAM_QUERY_MODE

CC = gcc
FC = gfortran

# AR: Build both lf_site_response variants (get_vs30 is a subroutine only, not a standalone binary)
all: lf_site_response lf_site_response_bbp

# AR: Ensure ../bin/ exists before targets run their inline cp
../bin/:
	mkdir -p $@

lf_site_response: | ../bin/
lf_site_response_bbp: | ../bin/
