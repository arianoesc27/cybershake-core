# AR: MareNostrum 5 (BSC) site-specific overrides for UCVM/src
# AR: Points to my own UCVM v25.7.1 install, not the shared WPG install

CC = mpicc

UCVM_HOME  = /gpfs/projects/bsc115/bsc203748/software/ucvm/install
# AR: Two header files live in the UCVM source tree itself, not in the install folder
UCVM_SRC   = /gpfs/projects/bsc115/bsc203748/software/ucvm
ETREE_HOME = ${UCVM_HOME}/lib/euclid3
PROJ4_HOME = ${UCVM_HOME}/lib/proj
VX_HOME    = ${UCVM_HOME}/model/cvmh
CVMS_HOME  = ${UCVM_HOME}/model/cvms
CVMSI_HOME = ${UCVM_HOME}/model/cvmsi
SFCVM_HOME = ${UCVM_HOME}/model/sfcvm

# AR: This embeds the library path directly into the binaries, so they find UCVM's shared
# AR: libraries at run time without needing LD_LIBRARY_PATH set
UCVM_RPATH = -Wl,-rpath,${UCVM_HOME}/lib \
             -Wl,-rpath,${VX_HOME}/lib \
             -Wl,-rpath,${CVMS_HOME}/lib \
             -Wl,-rpath,${CVMSI_HOME}/lib \
             -Wl,-rpath,${SFCVM_HOME}/lib \
             -Wl,-rpath,${PROJ4_HOME}/lib \
             -Wl,-rpath,${ETREE_HOME}/lib

# AR: This UCVM version renamed one library and added two new ones it depends on.
# AR: Some velocity models (CCA, CVMS5, CENCAL, CS173) are not installed in my UCVM build,
# AR: so I removed them from this list.
UCVMLIBS = -L${UCVM_HOME}/lib -lucvm -lgrd \
           -L${VX_HOME}/lib -lvxapi -lcvmh -lgctpc \
           -L${CVMS_HOME}/lib -lcvms \
           -L${CVMSI_HOME}/lib -lcvmsi \
           -L${SFCVM_HOME}/lib -lsfcvm -lgeomodelgrids \
           -L${PROJ4_HOME}/lib -lproj \
           -L${ETREE_HOME}/lib -letree \
           -lstdc++ -ldl ${UCVM_RPATH}

UCVMINC = -I${UCVM_HOME}/include -I${UCVM_SRC}/src/ucvm -I${GETPAR_HOME}/include

# AR: I only have one UCVM version installed, so I reuse the same libraries for both slots
UCVM_15_10_LIBS = ${UCVMLIBS}
UCVM_15_10_INC  = ${UCVMINC}

# AR: I removed the -static flag, since it doesn't work with two of the shared libraries
# AR: this needs. I added the getpar include path here since one build target needs it and
# AR: doesn't already have it.
CFLAGS = -O3 -g -I${GETPAR_HOME}/include

# AR: -lgfortran is needed for the Fortran code linked into one of the programs here, no
# AR: math library needed for this one
LDLIBS = -lm -L${GETPAR_HOME}/lib -lget -lgfortran

# AR: I skip building shear_modulus_from_srf, since it hardcodes paths from a different
# AR: cluster's setup that don't exist here
TARGETS = ucvm-mpi merge_cvm ucvm-single-mpi determine_surface_model ucvm-single-mpi-15.10

# AR: This makes sure the ../bin/ output folder exists before any target tries to copy its
# AR: built program there
../bin/:
	mkdir -p $@

all: | ../bin/
ucvm-single-mpi: | ../bin/
ucvm-single-mpi-15.10: | ../bin/
determine_surface_model: | ../bin/

# AR: The original list of build targets already includes shear_modulus_from_srf and
# AR: ucvm-single-mpi-18.5, which I'm skipping (see above), so I give both an empty recipe
# AR: here so the build doesn't fail when it reaches them.
shear_modulus_from_srf:
	@echo "AR: Skipping shear_modulus_from_srf, it hardcodes paths from a different cluster's setup"

ucvm-single-mpi-18.5:
	@echo "AR: Skipping ucvm-single-mpi-18.5, there is no source file for it in this repo version"

# AR: ucvm-single-mpi-15.10 was missing from the original list of build targets, so I add
# AR: it here separately
all: ucvm-single-mpi-15.10
